# Porta do servidor
PORT=3000

# URL pública do servidor (usada para montar links de fallback)
SERVER_URL=http://localhost:3000

# Segredo de sessão
SESSION_SECRET=change-me

# Senha do painel admin (opcional - prioridade para Firebase)
# Se não configurada no Firebase, use esta variável de ambiente
ADMIN_PASSWORD=

# Credenciais Firebase em JSON (string única)
# FIREBASE_CREDENTIALS={"type":"service_account",...}
FIREBASE_CREDENTIALS=
